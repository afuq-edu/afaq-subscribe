{
  "manifest_version": 3,
  "name": "حاضر — منصة أفق التعليمية",
  "short_name": "حاضر",
  "version": "4.1.0",
  "key": "",
  "description": "تعبئة تحاضير منصة نور تلقائيًا من اشتراكك في منصة أفق التعليمية: الفصل كاملًا، حصةً حصة، بتواريخها.",
  "default_locale": "ar",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "حاضر — تعبئة التحضير",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.moe.gov.om/*",
    "http://*.moe.gov.om/*",
    "https://*.supabase.co/*"
  ],
  "commands": {
    "fill-last": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "تعبئة الدرس المفتوح في نور بالحصة المقترحة"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.moe.gov.om/teacher/courses/add_preparation*",
        "https://*.moe.gov.om/teacher/courses/add_preparation*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lms.moe.gov.om/teacher/courses/preparations*",
        "https://*.moe.gov.om/teacher/courses/preparations*"
      ],
      "js": [
        "noorlist.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "styles.css",
        "packages.js",
        "engine.js",
        "match.js",
        "parse.js",
        "lib.js",
        "icons.js",
        "icons/*",
        "afaq-config.js",
        "remote.js"
      ],
      "matches": [
        "https://*.moe.gov.om/*",
        "http://*.moe.gov.om/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://afuq-edu.github.io/afaq-subscribe/*"
    ]
  }
}
