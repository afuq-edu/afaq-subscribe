  "tf": [
    { "s": "لضرب كسرين نضرب البسط في البسط والمقام في المقام.", "t": true, "why": "مثل (1/2) × (3/5) = 3/10." },
    { "s": "يجب توحيد المقامات قبل ضرب الكسور.", "t": false, "why": "توحيد المقامات للجمع والطرح فقط، ولا نحتاج إليه في الضرب." },
    { "s": "(2/3) × (3/4) = 1/2", "t": true, "why": "6/12 = 1/2، كما يظهر في نموذج المساحة." },
    { "s": "(1/2) × (3/5) = 3/10", "t": true, "why": "1 × 3 = 3 و2 × 5 = 10." },
    { "s": "ناتج ضرب كسرين كل منهما أصغر من 1 يكون أكبر من كل منهما.", "t": false, "why": "أخذ جزء من جزء يعطي ناتجًا أصغر، مثل (1/2) × (1/2) = 1/4." },
    { "s": "3 1/2 × 2 1/4 = 7 7/8", "t": true, "why": "(7/2) × (9/4) = 63/8 = 7 7/8." },
    { "s": "(4/9) × (3/8) = 1/6", "t": true, "why": "نحذف 4 مع 8 و3 مع 9 فنحصل على (1/3) × (1/2) = 1/6." },
    { "s": "1 1/2 × 4 = 4 1/2", "t": false, "why": "(3/2) × 4 = 12/2 = 6." },
    { "s": "لضرب الأعداد الكسرية نحولها أولًا إلى كسور غير اعتيادية.", "t": true, "why": "هذا يضمن ألا نهمل أي جزء من الضرب." },
    { "s": "(2/5) × 10 = 4/50", "t": false, "why": "(2 × 10)/5 = 20/5 = 4." }
  ],
