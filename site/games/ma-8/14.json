    { "lv": "التذكر", "q": "في نموذج المساحة لـ (2/3) × (3/4) يمثل الناتجَ:", "o": ["الجزء المظلل مرتين (المنطقة المشتركة)", "الجزء غير المظلل", "كل ما ظُلل مرة واحدة على الأقل", "عدد الصفوف فقط"], "why": "المنطقة المشتركة 6/12 = 1/2 من المستطيل." },
    { "lv": "التذكر", "q": "اكتب 2 1/4 كسرًا غير اعتيادي.", "o": ["9/4", "3/4", "6/4", "8/4"], "why": "2 × 4 + 1 = 9." },
