    { "lv": "التطبيق", "q": "مستطيل طوله 3/4 م وعرضه 2/5 م. ما مساحته؟", "o": ["3/10 م²", "5/9 م²", "23/20 م²", "15/8 م²"], "why": "(3/4) × (2/5) = 6/20 = 3/10." },
    { "lv": "التطبيق", "q": "أوجد 2/3 من 30.", "o": ["20", "10", "45", "15"], "why": "(2/3) × 30 = 60/3 = 20." },
    { "lv": "التطبيق", "q": "احسب: 3 1/3 × 1 4/5", "o": ["6", "3 4/15", "4 4/15", "5 1/3"], "why": "(10/3) × (9/5) = 90/15 = 6." },
    { "lv": "التحليل", "q": "هل حاصل ضرب عددين كسريين كل منهما أكبر من 1 أكبر من كل منهما؟", "o": ["نعم؛ لأن الضرب في عدد أكبر من 1 يكبّر العدد", "لا؛ بل أصغر منهما دائمًا", "يكون مساويًا لأكبرهما", "لا يمكن معرفة ذلك"], "why": "مثلًا 1 1/2 × 2 1/2 = 3 3/4، وهو أكبر من العددين." },
    { "lv": "التحليل", "q": "حسب طالب 3 1/2 × 2 1/4 بضرب 3 × 2 ثم 1/2 × 1/4 فحصل على 6 1/8. ما الخطأ؟", "o": ["أهمل أجزاء من الضرب؛ والصحيح بالتحويل 7 7/8", "لا يوجد خطأ", "كان يجب جمع العددين الكاملين", "الصحيح 6 1/4"], "why": "نموذج المساحة يبين أجزاء الضرب المفقودة في طريقته." },
    { "lv": "التحليل", "q": "أيهما أكبر: (3/4) × (2/3) أم (2/3) + (1/12)؟", "o": ["(2/3) + (1/12) لأنه 3/4 والآخر 1/2", "(3/4) × (2/3) لأن الضرب يكبّر دائمًا", "هما متساويان", "لا يمكن المقارنة بينهما"], "why": "(3/4) × (2/3) = 1/2، و(2/3) + (1/12) = 9/12 = 3/4." }
